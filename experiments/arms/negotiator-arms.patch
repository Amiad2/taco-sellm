+    def widest_deadband(self, case, v, s):
+        """EVAL arm `clause`: it insists on an index clause, so the clause stays - but the options hold
+        the same series with a deadband, and the arena's C says which variant costs us least (P08: a
+        deadband of 5 % is worth 22,823 against 0 % at the same price). Ask that one; if it refuses,
+        its next sheet brings its own clause back and we continue on that."""
+        clause = s["index_clause"]
+        options = [
+            o
+            for o in case.get("term_options", {}).get("index_clause") or []
+            if isinstance(o, dict) and o.get("series") == clause.get("series")
+        ]
+        if len(options) < 2:
+            return s
+        price = v.standing[1].get("unit_price") or 1.0
+        best = min(options, key=lambda o: v.c({**s, "index_clause": o, "unit_price": price}))
+        return {**s, "index_clause": best}
